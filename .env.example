# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analyst - hosted OpenAI model
OPENAI_API_KEY=
ANALYST_MODEL=openai/gpt-4.1-mini-2025-04-14

# SerperTool
SERPER_API_KEY=

# LangSmith - agentic tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nxs-core

# CrewAI's own telemetry is disabled; agent_logs is the application audit trail.
CREWAI_TELEMETRY_DISABLED=true
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
